VITE_API_BASE_URL=https://xyndrome.lk/api
VITE_API_BASE_URLS=https://xyndrome.lk/api
VITE_CAPACITOR_ANDROID_HOSTNAME=www.xyndrome.lk
VITE_LMS_BUILD_TARGET=native
VITE_ENABLE_PWA=false
VITE_APP_ONLY_HOSTS=app.xyndrome.lk,app-lms.xyndrome.lk
# Set to 'true' to turn on native push. Android still requires
# frontend/android/app/google-services.json before FCM registration is activated.
VITE_NATIVE_PUSH_ENABLED=true

# Native Google Sign-In (Capacitor). Required so the app uses the native picker
# instead of the WebView popup (which Google blocks with Error 400: invalid_request).
#   - VITE_GOOGLE_CLIENT_ID    = your WEB OAuth client id (used as Android serverClientId).
#                                If left blank, it is fetched at runtime from public settings.
#   - VITE_GOOGLE_IOS_CLIENT_ID = your iOS OAuth client id (required for iOS). Its
#                                 REVERSED_CLIENT_ID must also be added to ios Info.plist.
# Add BOTH the web client id and the iOS client id to the backend GOOGLE_CLIENT_IDS list
# (comma-separated) so the server accepts id_tokens from Android and iOS.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
