VITE_API_BASE_URL=/api
VITE_API_BASE_URLS=
VITE_API_REQUEST_TIMEOUT_MS=30000
VITE_API_TIMEOUT_RETRY_COUNT=2
VITE_API_TIMEOUT_RETRY_DELAY_MS=500
VITE_API_TIMEOUT_RETRY_WRITES=true
VITE_GOOGLE_CLIENT_ID=
# Sign in with Apple (web), redirect flow. Leave blank to hide the Apple button.
#  VITE_APPLE_SERVICES_ID   = the Services ID (e.g. lk.xyndrome.signin)
#  VITE_APPLE_REDIRECT_URI  = the BACKEND callback Apple posts to, e.g.
#                             https://xyndrome.lk/api/auth/apple/callback
# Register that callback as the Return URL on the Services ID, and add the
# Services ID to the backend APPLE_CLIENT_IDS.
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=
VITE_LMS_BUILD_TARGET=web
VITE_PUBLIC_WEBSITE_URL=https://xyndrome.lk
VITE_APP_ONLY_HOSTS=app.xyndrome.lk,app-lms.xyndrome.lk
VITE_APP_ONLY_HOST_PATTERN=^(app|app-lms)\.
