NODE_ENV=production
PORT=3000
FRONTEND_URL=https://xyndrome.lk
FRONTEND_URLS=https://xyndrome.lk,https://www.xyndrome.lk
APP_PUBLIC_URL=https://xyndrome.lk/lms
API_PUBLIC_URL=https://xyndrome.lk/api
BODY_LIMIT=8mb
ALLOW_LAN_ORIGINS=false
SETTINGS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
HEALTH_METRICS_TOKEN=replace-with-a-long-random-health-token
EXPOSE_DEV_RESET_TOKEN=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple — allowed token audiences (comma-separated): the iOS app
# bundle id AND the web Services ID. Defaults to app.xyndrome.lk if unset.
APPLE_CLIENT_IDS=app.xyndrome.lk
# Where the web Apple redirect flow sends the browser after sign-in (and on error).
APPLE_WEB_SUCCESS_URL=https://xyndrome.lk/lms/frontend/dist/dashboard
APPLE_WEB_FAILURE_URL=https://xyndrome.lk/lms/frontend/dist/auth/login?apple=failed
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.erpm.medical.lms
APNS_USE_SANDBOX=true
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=
FCM_PROJECT_ID=
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=
SMART_NOTES_LAYOUT_API_KEY=
SMART_NOTES_LAYOUT_MODEL=gemini-2.5-flash
SMART_NOTES_IMAGE_API_KEY=
SMART_NOTES_IMAGE_MODEL=gemini-2.5-flash-image
DB_HOST=localhost
DB_PORT=3306
DB_USER=lms_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=lms_db
# Two app copies overlap during a restart, so 2 x this must stay under the
# host's connection cap (cap 12 -> 6, cap 8 -> 4).
DB_CONNECTION_LIMIT=6
# Idle connections count against the cap too: keep 1, close after 10s unused.
DB_MAX_IDLE=1
DB_IDLE_TIMEOUT=10000
DB_CONNECT_TIMEOUT=10000
DB_QUEUE_LIMIT=100

# Lesson PDF/video links are signed. Leave unset (log-only) until the server log
# stops showing "[uploads] unsigned request", then set to true to enforce.
# ENFORCE_SIGNED_UPLOADS=true
# Optional; falls back to SETTINGS_ENCRYPTION_KEY.
# MEDIA_URL_SECRET=

# Which proxies in front of the API may report the real client address, for the
# per-IP rate limits. Default `loopback` suits a web server on the same machine.
# Use a hop count (e.g. 1) when the proxy is on another host, or false for none.
# TRUST_PROXY=loopback
